<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Define color patterns for console output -->
    <conversionRule conversionWord="clr" converterClass="org.springframework.boot.logging.logback.ColorConverter" />
    <conversionRule conversionWord="wex" converterClass="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter" />
    <conversionRule conversionWord="wEx" converterClass="org.springframework.boot.logging.logback.ExtendedWhitespaceThrowableProxyConverter" />
    
    <!-- Define properties for log patterns -->
    <property name="CONSOLE_LOG_PATTERN" value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>
    <property name="FILE_LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} ${LOG_LEVEL_PATTERN:-%5p} ${PID:- } --- [%t] %-40.40logger{39} : %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>
    
    <!-- Console appender with profile-specific configurations -->
    <springProfile name="!prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${CONSOLE_LOG_PATTERN}</pattern>
                <charset>utf8</charset>
            </encoder>
        </appender>
    </springProfile>
    
    <!-- File appenders for different log levels -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/product-management-availability-shred.log</file>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>utf8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/product-management-availability-shred.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>300MB</totalSizeCap>
        </rollingPolicy>
    </appender>
    
    <!-- Error log file appender -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/product-management-availability-shred-error.log</file>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>utf8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/product-management-availability-shred-error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>60</maxHistory>
            <totalSizeCap>600MB</totalSizeCap>
        </rollingPolicy>
    </appender>
    
    <!-- Audit log appender for business events -->
    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/product-management-availability-audit.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n</pattern>
            <charset>utf8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/product-management-availability-audit.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>5MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>450MB</totalSizeCap>
        </rollingPolicy>
    </appender>
    
    <!-- JMS message logging appender -->
    <appender name="JMS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/product-management-availability-jms.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n</pattern>
            <charset>utf8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/product-management-availability-jms.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>5MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>150MB</totalSizeCap>
        </rollingPolicy>
    </appender>
    
    <!-- Async appender for better performance -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE"/>
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
    </appender>
    
    <!-- Logger configurations by profile -->
    
    <!-- Development profile -->
    <springProfile name="dev">
        <logger name="ai.shreds.product_management_availability_shred_g5ds" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </logger>
        
        <logger name="org.springframework.web" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </logger>
        
        <logger name="org.hibernate.SQL" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </logger>
        
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>
    
    <!-- Test profile -->
    <springProfile name="test">
        <logger name="ai.shreds.product_management_availability_shred_g5ds" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>
        
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
    
    <!-- Production profile -->
    <springProfile name="prod">
        <!-- Audit logger for business events -->
        <logger name="ai.shreds.product_management_availability_shred_g5ds.infrastructure.logging.InfrastructureAuditLogger" 
                level="INFO" additivity="false">
            <appender-ref ref="AUDIT_FILE"/>
        </logger>
        
        <!-- JMS message logger -->
        <logger name="ai.shreds.product_management_availability_shred_g5ds.adapters.primary.AdapterJMSMessageListener" 
                level="INFO" additivity="false">
            <appender-ref ref="JMS_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </logger>
        
        <logger name="ai.shreds.product_management_availability_shred_g5ds.adapters.primary.AdapterJMSMessagePublisher" 
                level="INFO" additivity="false">
            <appender-ref ref="JMS_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </logger>
        
        <!-- Application logger -->
        <logger name="ai.shreds.product_management_availability_shred_g5ds" level="INFO" additivity="false">
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </logger>
        
        <!-- External service integration logs -->
        <logger name="ai.shreds.product_management_availability_shred_g5ds.infrastructure.external_services" 
                level="INFO" additivity="false">
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </logger>
        
        <!-- Database operation logs -->
        <logger name="ai.shreds.product_management_availability_shred_g5ds.infrastructure.repositories" 
                level="WARN" additivity="false">
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </logger>
        
        <!-- Spring framework logs -->
        <logger name="org.springframework" level="WARN" additivity="false">
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </logger>
        
        <!-- Hibernate logs -->
        <logger name="org.hibernate" level="WARN" additivity="false">
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </logger>
        
        <!-- JMS and ActiveMQ logs -->
        <logger name="org.apache.activemq" level="WARN" additivity="false">
            <appender-ref ref="JMS_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </logger>
        
        <!-- Redis logs -->
        <logger name="org.springframework.data.redis" level="WARN" additivity="false">
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </logger>
        
        <root level="WARN">
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
    </springProfile>
    
    <!-- Specific logger configurations for monitoring and debugging -->
    
    <!-- Circuit breaker and retry logs -->
    <logger name="io.github.resilience4j" level="INFO" additivity="false">
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>
    
    <!-- Scheduling logs -->
    <logger name="org.springframework.scheduling" level="INFO" additivity="false">
        <appender-ref ref="FILE"/>
    </logger>
    
    <!-- Cache operation logs -->
    <logger name="org.springframework.cache" level="INFO" additivity="false">
        <appender-ref ref="FILE"/>
    </logger>
    
    <!-- Validation logs -->
    <logger name="org.springframework.validation" level="WARN" additivity="false">
        <appender-ref ref="ERROR_FILE"/>
    </logger>
    
</configuration>